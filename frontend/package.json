{
  "name": "frontend",
  "private": true,
  "version": "4.6.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:lines": "node scripts/check-file-lines.js",
