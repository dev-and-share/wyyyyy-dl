# ==============================================================================
# Stage 0: Build Svelte 5 frontend
# ==============================================================================
FROM node:22-alpine AS frontend-builder
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json* ./frontend/
RUN --mount=type=cache,target=/root/.npm cd frontend && npm ci --ignore-scripts
COPY frontend/ ./frontend/
RUN cd frontend && npm run build

# ==============================================================================
# Stage 1: Build GraalVM Native Image
# ==============================================================================
FROM ghcr.io/graalvm/native-image-community:21 AS builder

# 安装 findutils (包含 xargs 工具供 gradlew 使用)
RUN microdnf install -y findutils && microdnf clean all

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

WORKDIR /build

# 拷贝 Gradle 核心配置文件（利用 Docker 缓存层）
COPY gradlew settings.gradle build.gradle gradle.properties ./
COPY gradle/ ./gradle/
RUN chmod +x ./gradlew

# 预先拉取并缓存 Gradle Wrapper
RUN --mount=type=cache,target=/root/.gradle ./gradlew --version

# 拷贝源代码 + 已编译的 Svelte 产物
COPY src/ ./src/
COPY --from=frontend-builder /build/src/main/resources/static/svelte ./src/main/resources/static/svelte

# 编译生成原生二进制文件（跳过测试，启用 Gradle 缓存挂载）
RUN --mount=type=cache,target=/root/.gradle ./gradlew nativeCompile -x test --no-daemon

# ==============================================================================
# Stage 2: Runtime Container
# ==============================================================================
FROM ubuntu:22.04

# 安装运行时必要组件：ca-certificates (HTTPS), tzdata (时区), libfreetype6/fontconfig (二维码 AWT ImageIO)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        libfreetype6 \
        fontconfig \
        libxrender1 \
        libxext6 \
        libxi6 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 创建音乐及外部库目录
RUN mkdir -p /app /media/music /media/external

# 从 Stage 1 拷贝编译完成的原生二进制文件
COPY --from=builder /build/build/native/nativeCompile/wyyyyy-dl-native /app/wyyyyy-dl
RUN chmod +x /app/wyyyyy-dl

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=Asia/Shanghai
ENV AUTHER=wyyyyy-dl

EXPOSE 8080

ENTRYPOINT ["/app/wyyyyy-dl"]
