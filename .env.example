# ==========================================================================
# NetEase Music Downloader - 本地环境配置模板示例 (.env.example)
# 使用说明: 请复制本文件并重命名为 .env，并修改为您本地宿主机实际的音乐下载目录
# ==========================================================================

# 宿主机 Mac / Windows 本地实际存储音乐的绝对路径
HOST_DOWNLOAD_PATH=/path/to/your/music/downloads
