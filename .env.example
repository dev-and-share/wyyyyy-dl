# 🎵 网易云音乐下载器 - 宿主机环境变量配置文件 (.env)

# 1. 宿主机主下载保存目录（必填：映射到容器 /media/music）
HOST_DOWNLOAD_PATH=/Users/test/Downloads/MyMusic

# 2. 外部曲库根目录（宿主机路径，只会留在本机 .env；以只读方式挂载到容器）
# 将所有需要扫描的曲库子目录放在这个根目录下即可，无须修改 docker-compose.yml。
EXTERNAL_LIBRARY_HOST_PATH=/Users/test/Music
EXTERNAL_LIBRARY_CONTAINER_PATH=/media/external

# 3. 需要扫描的容器内目录。通常保留一个根目录即可（支持分号或逗号分隔）。
EXTERNAL_LIBRARY_PATHS=/media/external

# 4. 🔐 Cloudflare Access 多租户与管理员邮箱配置（以英文逗号分隔）
# 未配置或留空时系统处于全量开放模式；配置后仅列表中邮箱为管理员，其他通过 CF 认证的邮箱为普通访客
CF_ADMIN_EMAILS=javaeecoding@gmail.com
ADMIN_EMAILS=javaeecoding@gmail.com

# 5. AWS CloudFront 边缘账密认证 (HTTP Basic Auth)
CLOUDFRONT_AUTH_USERNAME=admin
CLOUDFRONT_AUTH_PASSWORD=Ww121212
AUTH_USERNAME=admin
AUTH_PASSWORD=Ww121212
