#!/bin/sh

echo "🔍 [pre-commit] Starting quality gate checks..."

cd frontend || exit 1

# 1. 500-line file limit check
echo "📏 Checking 500-line file limit (frontend/src)..."
npm run check:lines
if [ $? -ne 0 ]; then
  echo "🚨 500-line check failed! Commit aborted."
  exit 1
fi

# 2. Svelte & TypeScript compilation check
echo "📘 Running Svelte & TypeScript check (svelte-check)..."
npm run check
if [ $? -ne 0 ]; then
  echo "🚨 Svelte / TypeScript check failed! Commit aborted."
  exit 1
fi

# 3. Unit Tests
echo "🧪 Running Unit Tests (vitest)..."
npm test
if [ $? -ne 0 ]; then
  echo "🚨 Unit tests failed! Commit aborted."
  exit 1
fi

# 4. Production Build Verification
echo "📦 Running production build check (vite build)..."
npm run build
if [ $? -ne 0 ]; then
  echo "🚨 Production build failed! Commit aborted."
  exit 1
fi

echo "🎉 All quality checks passed successfully!"
